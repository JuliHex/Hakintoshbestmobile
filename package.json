{
  "name": "hakintoshbestmobile-main",
  "version": "1.0.0",
  "description": "HakintoshBestMobile website",
  "main": "postcss.config.js",
  "scripts": {
    "dev": "postcss src/css/main.css -o assets/css/styles.css --watch",
    "build:css": "postcss src/css/main.css -o assets/css/styles.css",
    "build:js": "esbuild src/islands/liquid-glass.jsx --bundle --minify --format=iife --jsx=automatic --target=es2020 --define:process.env.NODE_ENV='\"production\"' --outfile=assets/js/liquid-glass.js",
    "build": "npm run build:js && npm run build:css"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "liquid-glass-react": "^1.1.1",
    "postcss": "^8.5.4",
    "postcss-cli": "^11.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^3.4.17"
  }
}
